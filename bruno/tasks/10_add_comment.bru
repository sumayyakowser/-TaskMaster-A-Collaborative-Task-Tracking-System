meta {
  name: 10 Add Comment
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/tasks/{{taskId}}/comments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "message": "Looking into this issue now."
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("commentId", res.body.data.id);
  }
}
