meta {
  name: 01 Create Task
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/tasks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Fix login bug",
    "description": "JWT token expires too early",
    "dueDate": "2026-07-20"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("taskId", res.body.data.id);
  }
}
